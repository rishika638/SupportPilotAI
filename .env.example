NODE_ENV=development
PORT=3000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

POSTGRES_USER=supportpilot
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=supportpilot
DATABASE_URL_DOCKER=postgresql://supportpilot:change-me-postgres-password@postgres:5432/supportpilot?schema=public
DATABASE_URL=postgresql://supportpilot:change-me-postgres-password@localhost:5432/supportpilot?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

METRICS_TOKEN=change-me-metrics-token-32-plus-chars

# AI Provider: "gemini", "openai", or "ollama"
AI_PROVIDER=gemini
# Required when AI_PROVIDER=gemini. Keep this value local and out of version control.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Ollama / OpenAI-compatible provider (used when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
OLLAMA_API_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# REDIS_TLS must be true when the configured Redis endpoint uses rediss://.
